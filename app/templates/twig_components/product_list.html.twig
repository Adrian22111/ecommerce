{% trans_default_domain 'client.product' %}

<div class="px-8 py-4 bg-gray-200 rounded-xl">
    <h2>{{ 'our_products'|trans }}</h2>
    <div class="grid grid-cols-5">
        {% for product in this.products %}
            <a href="{{ path('client_product_show', {id: product.id}) }}" class="p-4 relative group/product hover:shadow-lg rounded-xl">
                <div class="max-w-full">
                    {% if product.productImages|first %}
                        <img class="rounded-xl" src="{{ this.imageUrl(product.productImages|first) }}" alt="{{ product.name }}"/>
                    {% else %}
                        <img class="rounded-xl" src="/images/placeholders/no_image_placeholder.jpg" alt="{{ product.name }}"/>
                    {% endif %}
                </div>
                <div class="mt-2">
                    <div>{{ product.name }}</div>
                    <div>{{ product.price }}</div>
                </div>
                <div class="absolute bottom-4 right-4 hidden group-hover/product:block rounded-md p-1 border hover:border-indigo-600 group/cart">
                    <i class="fa-solid fa-cart-shopping fa-xl group-hover/cart:text-indigo-600" aria-hidden="true"></i>
                </div>
            </a>
        {% endfor %}
    </div>
</div>
