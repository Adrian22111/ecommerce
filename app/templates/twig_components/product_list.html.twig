<div class="grid grid-cols-5 gap-8">
    {% for product in this.products %}
        <div>
            <div class="max-w-full">
                {% if product.productImages|first %}
                    <img src="{{ this.imageUrl(product.productImages|first) }}" alt="{{ product.name }}"/>
                    {{ product.name }}
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>
