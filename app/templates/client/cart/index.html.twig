{% extends 'client/base.html.twig' %}
{% trans_default_domain 'client.cart' %}

{% block title %}Cart{% endblock %}

{% block body %}
    <div class="max-w-[90rem] w-full">
        {% if not cartItemDtos %}
            <div class="border-2 border-indigo-500/80 bg-indigo-600/20
                    backdrop-blur-md text-indigo-700
                    rounded-lg px-6 py-3
                    text-center text-2xl"
            >
                {{ 'empty_cart'|trans }}
            </div>
        {% else %}
            <div class="grid grid-cols-5 gap-4">
                <div class="rounded-xl col-span-4 flex flex-col gap-2">
                    {% for cartItemDto in cartItemDtos %}
                        <div class="flex gap-4 bg-gray-200 px-4 py-2 rounded-md">
                            <div class="max-w-24">
                                {% if cartItemDto.product.productImages|first %}
                                    <img class="rounded-md" src="{{ thumbnailPath(cartItemDto.product.productImages|first, 'cart_list_thumbnail_small') }}" alt="{{ product.name }}"/>
                                {% else %}
                                    <img class="rounded-md" src="/images/placeholders/no_image_placeholder.jpg" alt="{{ cartItemDto.product.name }}"/>
                                {% endif %}
                            </div>
                            <div class="flex justify-between w-full">
                                <div>{{ cartItemDto.product.name }}</div>
                                <div class="flex flex-col items-end">
                                    <div>{{ cartItemDto.product.price }}</div>
                                    <div>{{ cartItemDto.quantity }}</div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <div class="col-span-1">
                    Total Value Of Products
                </div>
            </div>
        {% endif %}

    </div>
{% endblock %}
