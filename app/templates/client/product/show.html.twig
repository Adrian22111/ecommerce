{% extends 'client/base.html.twig' %}

{% block title %}Hello HomePageController!{% endblock %}

{% block body %}
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>{{ product.price }}</td>
            </tr>
            <tr>
                <th>Add_date</th>
                <td>{{ product.addDate ? product.addDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Last_update</th>
                <td>{{ product.lastUpdate ? product.lastUpdate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ product.description }}</td>
            </tr>
            <tr>
                <th>Symbol</th>
                <td>{{ product.symbol }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('client_product_index') }}">back to list</a>


{% endblock %}
